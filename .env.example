# .env.local로 복사해 값을 채운다 (cp .env.example .env.local)

# Supabase — 서버 전용 (NEXT_PUBLIC_ 접두사 금지, CLAUDE.md # Supabase)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_STORAGE_URL=
# 결제 원장 기록(record_payment) 전용 secret key(sb_secret_...). RLS를 우회하므로 결제 BFF 서버 코드에서만 쓴다
# Supabase 대시보드 → Project Settings → API Keys → Secret keys
SUPABASE_SECRET_KEY=

# NAVER Cloud Maps (console.ncloud.com → Maps → Application)
# - Dynamic Map: 브라우저 지도 SDK(components/naver-map/NaverMap.tsx). Client ID는 브라우저에 노출되므로
#   콘솔 Application의 Web 서비스 URL(예: http://localhost:3000)로 사용처를 제한한다
NEXT_PUBLIC_NCP_MAPS_KEY_ID=
# - Reverse Geocoding: 지도 중심 좌표 → 주소(BFF app/api/location/address). 서버 전용
#   NCP_MAPS_KEY_ID는 위 Client ID와 같은 값, NCP_MAPS_KEY는 Client Secret
NCP_MAPS_KEY_ID=
NCP_MAPS_KEY=

# NAVER API HUB 지역 검색 (console.ncloud.com → NAVER API HUB → 검색 API 구독 후 Application 등록). 서버 전용
# 장소 검색 BFF(app/api/location/search). Maps Application 키와 별개이며, 구독하지 않은 키는 401(210 Permission Denied)
# https://api.ncloud-docs.com/docs/naver-api-hub-search-local
NCP_SEARCH_KEY_ID=
NCP_SEARCH_KEY=

# PortOne V2 결제 (admin.portone.io). 규칙: .claude/rules/payment.md
# - 상점 아이디 · 채널 키: 브라우저 결제창(PortOne.requestPayment)에 넣는 공개 식별자. 서버 검증에도 같은 값을 쓴다
NEXT_PUBLIC_PORTONE_STORE_ID=
NEXT_PUBLIC_PORTONE_CHANNEL_KEY=
# - V2 API Secret: 결제 단건 조회로 결제를 검증할 때만 쓴다. 서버 전용 (결제 연동 → 연동 정보 → API Keys)
PORTONE_API_SECRET=

# PortOne V2 웹훅 (BFF app/api/payments/webhook). 서버 전용
# - 웹훅 시크릿: 서명 검증(Webhook.verify)용 (결제 연동 → 연동 정보 → 웹훅 → 테스트/실연동 각각 발급)
# - 웹훅 URL: https://<도메인>/api/payments/webhook, 버전 2024-04-25. 로컬은 터널(ngrok 등)로 노출
PORTONE_WEBHOOK_SECRET=
