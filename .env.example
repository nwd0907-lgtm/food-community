# .env.local로 복사해 값을 채운다 (cp .env.example .env.local)

# Supabase — 서버 전용 (NEXT_PUBLIC_ 접두사 금지, CLAUDE.md # Supabase)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_STORAGE_URL=

# NAVER Cloud Maps (console.ncloud.com → Maps → Application)
# - Dynamic Map: 브라우저 지도 SDK(components/naver-map/NaverMap.tsx). Client ID는 브라우저에 노출되므로
#   콘솔 Application의 Web 서비스 URL(예: http://localhost:3000)로 사용처를 제한한다
NEXT_PUBLIC_NCP_MAPS_KEY_ID=
# - Reverse Geocoding: 지도 중심 좌표 → 주소(BFF app/api/location/address). 서버 전용
#   NCP_MAPS_KEY_ID는 위 Client ID와 같은 값, NCP_MAPS_KEY는 Client Secret
NCP_MAPS_KEY_ID=
NCP_MAPS_KEY=

# NAVER API HUB 지역 검색 (console.ncloud.com → NAVER API HUB → 검색 API 구독 후 Application 등록). 서버 전용
# 장소 검색 BFF(app/api/location/search). Maps Application 키와 별개이며, 구독하지 않은 키는 401(210 Permission Denied)
# https://api.ncloud-docs.com/docs/naver-api-hub-search-local
NCP_SEARCH_KEY_ID=
NCP_SEARCH_KEY=
